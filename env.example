# Configuration de l'environnement pour XC Afrique Backend
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# Port du serveur
PORT=5000

# Environnement (development, production)
NODE_ENV=development

# URL de la base de données MongoDB
# Format: mongodb://localhost:27017/xcafrique
# Ou pour MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/xcafrique
MONGODB_URI=mongodb://localhost:27017/xcafrique

# Secret pour JWT (générer une chaîne aléatoire sécurisée)
# Vous pouvez générer un secret avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre_secret_jwt_tres_securise_changez_moi
JWT_EXPIRE=7d

# URL du frontend React (pour CORS)
# Pour plusieurs origines, séparer par des virgules: http://localhost:3000,http://localhost:5173
# En production: https://xcafrique.org,https://www.xcafrique.org
# En preview: https://xcafrique-frontend.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Alternative: Utiliser ALLOWED_ORIGINS (prioritaire si défini)
# Production: ALLOWED_ORIGINS=https://xcafrique.org,https://www.xcafrique.org
# Preview: ALLOWED_ORIGINS=https://xcafrique-frontend.vercel.app,https://*.vercel.app
# Development: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email de l'auteur (pour recevoir les notifications de partage d'articles)
# Si non défini, utilise CONTACT_EMAIL par défaut
AUTHOR_EMAIL=votre-email@example.com

# Configuration SMTP pour l'envoi d'emails (notifications de partage, contact, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app

# Email de contact (utilisé pour les notifications et les réponses)
CONTACT_EMAIL=contact@xcafrique.org

